    <string name="confirm">Confirmar</string>
    <string name="data_deleted">Datos borrados</string>
    <string name="terms_text">Al usar AssistZaya aceptas usar la app solo para contenido que estés autorizado a ver o descargar. No redistribuyas contenido sin permiso. El servicio puede cambiar o suspenderse en cualquier momento. Si tienes dudas, contacta con soporte.</string>
